APP_HOST=127.0.0.1
APP_PORT=8765
DATABASE_PATH=./data/clausecraft.sqlite3
MODEL_TIMEOUT_SECONDS=180

# Choose ONE of the three blocks below. There is no automatic fallback to mock.

# A. DeepSeek (OpenAI-compatible API). Material is sent to api.deepseek.com.
MODEL_PROVIDER=openai
OPENAI_BASE_URL=https://api.deepseek.com/v1
MODEL_NAME=deepseek-flash
# MODEL_NAME=deepseek-v4-pro
OPENAI_API_KEY=

# B. Local Ollama. Material stays on this computer.
# MODEL_PROVIDER=ollama
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# MODEL_NAME=qwen3:4b-instruct-2507-q4_K_M

# C. Mock: only checks saving, step wiring and errors. Produces no review opinion.
# MODEL_PROVIDER=mock
